# Copia este archivo como .env y llena los datos (el .env no se sube a git).
# Fuera de Docker usa / en las rutas de Windows (C:/...), el .env se lee como .properties.

# Base de datos (la misma de kia)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Columna mac de la tabla maquina. Vacio en Windows (fuera de Docker) = el mismo identificador que kia.
# En Docker es obligatorio: pon el mismo que use kia-worker-ia para que compartan el "un proceso a la vez".
WORKER_MAQUINA_ID=

# Carpetas en este equipo (fuera de Docker). En Docker se montan como volumenes (docker-compose.yml).
PATH_MAIN=C:/kia_main/kia_proyectos
KIA_TEMP=C:/kia_main/kia_temp
RECURSOS_DIR=recursos

# Drive: false para probar sin subir (los videos se quedan en la carpeta del proyecto)
DRIVE_HABILITADO=true
GDRIVE=gdrive

# Ajustes
SEGUNDO_INICIO_JOIN=8
INTERVALO_SEG=10
UN_PROCESO_POR_MAQUINA=true
